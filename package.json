{
  "name": "portafolio-maneldev-react",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "build:pages": "vite build --mode pages && node scripts/prepare-pages.js",
    "predeploy": "npm run build:pages",
    "deploy": "gh-pages -d dist --dotfiles"
  },
  "dependencies": {
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "gh-pages": "^6.3.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.3"
  },
  "homepage": "https://mballesterdev.github.io/Portafolio2026/"
}
